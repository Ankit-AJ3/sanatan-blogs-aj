# Public URL of the site (used for SEO: canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB — Atlas connection string (mongodb+srv://...), database name included
MONGODB_URI=

# Cloudinary (image uploads) — cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated Google emails that can write/edit/delete articles
ADMIN_EMAILS=you@gmail.com
