# Public URL of the site (used for SEO: canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB — Atlas connection string (mongodb+srv://...), database name included
MONGODB_URI=

# Cloudinary (image uploads) — cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email sending for sign-up OTP codes (pick ONE).
# 1) Resend — https://resend.com (simplest): add your domain, then
EMAIL_FROM="Sanatan Blogs <noreply@your-domain.com>"
RESEND_API_KEY=
# 2) or SMTP (e.g. Gmail with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# With neither set, codes are printed in the server console (development only).

# Comma-separated admin emails that can write/edit/delete articles
ADMIN_EMAILS=you@gmail.com

# Secret URL for the admin login page, e.g. sb-control-9f2a7c41 (use your own random value).
# Visit https://your-domain.com/<this value> to sign in as admin. /admin returns 404 to everyone else.
ADMIN_LOGIN_PATH=
